/* pages/import/import.wxss - 智能导入页样式 */

.import-page {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

@media (min-width: 550px) {
  .import-page {
    max-width: 760px;
    margin: 0 auto;
  }
}

/* ===== 标题 ===== */
.imp-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
  padding: 0 6rpx;
}

/* ===== 提示 ===== */
.tip {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  margin-bottom: 18rpx;
  padding: 0 6rpx;
}

.imp-note {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #b45309;
  background: #FEF3C7;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  line-height: 1.5;
}

/* ===== 文字输入 ===== */
.text-area {
  width: 100%;
  height: 360rpx;
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  box-sizing: border-box;
}

.parse-btn {
  margin-top: 24rpx;
  background: #185FA5;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 18rpx;
}

.parse-btn:active {
  background: #0C447C;
}

/* ===== 图片选择 ===== */
.photo-pick {
  background: #fff;
  border-radius: 18rpx;
  height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  color: #bbb;
}

.photo-plus {
  font-size: 80rpx;
  line-height: 1;
}

.photo-text {
  font-size: 28rpx;
}

.photo-hint {
  font-size: 25rpx;
  color: #07a34a;
  background: #e9f9ef;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  margin: 16rpx 0 4rpx;
  line-height: 1.5;
}

/* ===== 解析结果 ===== */
.result-head {
  font-size: 26rpx;
  color: #666;
  margin: 28rpx 6rpx 16rpx;
}

.cand-card {
  background: #fff;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.cand-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cand-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  color: #ccc;
  font-size: 28rpx;
  text-align: center;
  line-height: 44rpx;
  flex-shrink: 0;
}

.cand-check.on {
  background: #185FA5;
  border-color: #185FA5;
  color: #fff;
}

.cand-name {
  flex: 1;
  font-size: 32rpx;
  color: #333;
  height: 56rpx;
}

.cand-warn {
  font-size: 22rpx;
  color: #b45309;
  background: #FEF3C7;
  border-radius: 10rpx;
  padding: 8rpx 14rpx;
  margin: 12rpx 0 4rpx;
}

.cand-row {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
}

.cand-input {
  flex: 1;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #333;
  height: 56rpx;
  box-sizing: border-box;
}

.cand-pick {
  flex: 1;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.cand-pick-label {
  font-size: 24rpx;
  color: #999;
}

.cand-pick-val {
  font-size: 26rpx;
  color: #185FA5;
  font-weight: 500;
}

.import-btn {
  margin-top: 8rpx;
  background: #1aad19;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 20rpx;
}

.import-btn:active {
  background: #158c14;
}

/* 一键填入示例链接 */
.fill-link {
  display: inline-block;
  margin-top: 12rpx;
  color: #185FA5;
  font-size: 25rpx;
  font-weight: 500;
  padding: 6rpx 0;
}
.fill-link:active {
  opacity: 0.55;
}

/* 周次标签 */
.cand-week {
  font-size: 22rpx;
  color: #185FA5;
  background: #EAF2FB;
  border-radius: 10rpx;
  padding: 6rpx 14rpx;
  margin: 12rpx 0 2rpx;
  display: inline-block;
}

/* ===== 底部固定提示 ===== */
.bottom-fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #185FA5;
  color: #fff;
  font-size: 25rpx;
  text-align: center;
  padding: 22rpx 24rpx;
  line-height: 1.5;
  z-index: 50;
}

@media (min-width: 550px) {
  .bottom-fixed {
    max-width: 760px;
    margin: 0 auto;
  }
}

.bottom-space {
  height: 120rpx;
}
