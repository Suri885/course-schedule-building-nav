/* pages/review-study/review-study.wxss */
.rs-bg {
  min-height: 100vh;
  background: #f4f6fa;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

@media (min-width: 550px) {
  .rs-bg {
    max-width: 700px;
    margin: 0 auto;
  }
}

.rs-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 6rpx 6rpx 20rpx;
}

.rs-top-left {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.rs-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.rs-sub {
  font-size: 21rpx;
  color: #8a97a8;
  margin-top: 8rpx;
}

.rs-edit {
  background: #ffffff;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  border: 2rpx solid #e4e9f0;
}

.rs-edit-txt {
  font-size: 21rpx;
  color: #4a5a6a;
}

.rs-card {
  background: #ffffff;
  border-radius: 22rpx;
  padding: 26rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 45, 61, 0.05);
}

.rs-question {
  font-size: 30rpx;
  line-height: 1.75;
  color: #1f2d3d;
  white-space: pre-wrap;
}

.rs-img-card {
  padding: 14rpx;
}

.rs-img {
  width: 100%;
  border-radius: 14rpx;
  display: block;
}

.rs-img-hint {
  display: block;
  text-align: center;
  font-size: 19rpx;
  color: #a5aebb;
  padding: 14rpx 0 6rpx;
}

.rs-video {
  width: 100%;
  height: 380rpx;
  border-radius: 14rpx;
  background: #000;
}

.rs-answer-card {
  background: linear-gradient(150deg, #F2F8FF 0%, #FFFFFF 60%);
  border: 2rpx solid #D6E6F7;
}

.rs-label {
  display: block;
  font-size: 21rpx;
  color: #4A6C93;
  margin-bottom: 12rpx;
}

.rs-answer {
  font-size: 29rpx;
  line-height: 1.8;
  color: #1f2d3d;
  white-space: pre-wrap;
}

.rs-answer-empty {
  font-size: 23rpx;
  color: #a5aebb;
}

.rs-show {
  height: 92rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 2rpx dashed #b9cbe0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rs-show-txt {
  font-size: 26rpx;
  color: #185FA5;
  font-weight: 600;
}

.rs-mastered {
  margin-top: 18rpx;
  background: #EFF9F2;
  border: 2rpx solid #C6E9D3;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rs-mastered-txt {
  font-size: 22rpx;
  color: #2E9E5B;
  flex: 1;
  line-height: 1.5;
}

.rs-mastered-undo {
  font-size: 21rpx;
  color: #667085;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.rs-master {
  margin-top: 18rpx;
  background: #ffffff;
  border: 2rpx dashed #d6dde7;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rs-master-txt {
  font-size: 22rpx;
  color: #8a97a8;
}

.rs-pad {
  height: 190rpx;
}

/* 底部操作 */
.rs-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 18rpx 28rpx 34rpx;
  background: linear-gradient(180deg, rgba(244, 246, 250, 0) 0%, #f4f6fa 40%);
}

.rs-btn {
  flex: 1;
  height: 100rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
}

.rs-btn:last-child {
  margin-right: 0;
}

.rs-btn-fail {
  flex: 0 0 240rpx;
  background: #ffffff;
  border: 2rpx solid #F0C7C7;
}

.rs-txt-fail {
  color: #C0393D;
}

.rs-btn-ok {
  background: linear-gradient(120deg, #2E9E5B 0%, #1F7F48 100%);
  box-shadow: 0 10rpx 22rpx rgba(46, 158, 91, 0.26);
}

.rs-txt-ok {
  color: #ffffff;
  font-weight: 600;
}

.rs-btn-txt {
  font-size: 28rpx;
}
