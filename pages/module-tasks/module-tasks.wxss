/* pages/module-tasks/module-tasks.wxss */
.mt-bg {
  min-height: 100vh;
  background: linear-gradient(160deg, #eaf1fb 0%, #f4f7fc 60%, #eef3fb 100%);
  padding-bottom: 60rpx;
}

/* 模块头 */
.mt-head {
  padding: 44rpx 40rpx 38rpx;
  color: #fff;
}

.mt-head-title {
  font-size: 40rpx;
  font-weight: 700;
}

.mt-head-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.9;
  display: block;
}

.mt-head-score {
  margin-top: 20rpx;
  display: flex;
  align-items: baseline;
}

.mt-head-got {
  font-size: 50rpx;
  font-weight: 700;
}

.mt-head-max {
  font-size: 24rpx;
  opacity: 0.9;
}

.mt-head-bar {
  margin-top: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.3);
  overflow: hidden;
}

.mt-head-bar-in {
  height: 100%;
  background: #FFD66B;
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.mt-head-foot {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mt-head-remain {
  font-size: 23rpx;
  font-weight: 600;
  color: #ffffff;
  opacity: 0.95;
}

.mt-head-pending {
  font-size: 20rpx;
  color: #FFF0C9;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

/* 口径说明 */
.mt-note {
  margin: 22rpx 28rpx 0;
  padding: 18rpx 24rpx;
  background: #FFF8E8;
  border: 1rpx solid #F2DFB4;
  border-radius: 16rpx;
}

.mt-note-txt {
  font-size: 21rpx;
  color: #8a6d3b;
  line-height: 1.6;
}

/* 任务标签 */
.mt-task-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.mt-task-tag {
  font-size: 19rpx;
  border-radius: 8rpx;
  padding: 3rpx 12rpx;
  margin-right: 12rpx;
}

.tag-pending {
  color: #B8741A;
  background: #FDF2E0;
}

.tag-penalty {
  color: #C0393D;
  background: #FDECEC;
}

/* 任务卡 */
.mt-task {
  margin: 22rpx 28rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx 26rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 20rpx rgba(31, 45, 61, 0.06);
}

.mt-task-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-right: 16rpx;
}

.mt-task-title {
  font-size: 31rpx;
  font-weight: 600;
  color: #1f2d3d;
}

.mt-task-content {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7686;
  line-height: 1.6;
}

.mt-task-right {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.mt-task-score {
  display: flex;
  align-items: baseline;
}

.mt-task-got {
  font-size: 36rpx;
  font-weight: 700;
  color: #185FA5;
}

.mt-task-cap {
  font-size: 23rpx;
  color: #9aa6b5;
  margin-left: 2rpx;
}

.mt-task-arrow {
  margin-left: 14rpx;
  font-size: 40rpx;
  color: #c4cedb;
}

.mt-bottom-tip {
  margin: 30rpx 28rpx 0;
  padding: 22rpx 26rpx;
  background: #fff;
  border-radius: 18rpx;
}

.mt-bottom-text {
  font-size: 23rpx;
  color: #9aa6b5;
  line-height: 1.7;
}

.mt-bottom-sub {
  display: block;
  margin-top: 8rpx;
}
