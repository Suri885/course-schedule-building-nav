/* pages/review-edit/review-edit.wxss */
.re-bg {
  min-height: 100vh;
  background: #f4f6fa;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

@media (min-width: 550px) {
  .re-bg {
    max-width: 700px;
    margin: 0 auto;
  }
}

.re-card {
  background: #ffffff;
  border-radius: 22rpx;
  padding: 24rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 45, 61, 0.05);
}

.re-label {
  display: block;
  font-size: 23rpx;
  color: #667085;
  margin-bottom: 14rpx;
}

.re-label-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.re-label-row .re-label {
  margin-bottom: 0;
}

.re-hint {
  font-size: 19rpx;
  color: #a5aebb;
}

.re-input {
  width: 100%;
  height: 84rpx;
  background: #f7f9fc;
  border-radius: 14rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
  color: #1f2d3d;
  box-sizing: border-box;
}

.re-textarea {
  width: 100%;
  min-height: 220rpx;
  background: #f7f9fc;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  line-height: 1.65;
  color: #1f2d3d;
  box-sizing: border-box;
}

.re-textarea-answer {
  min-height: 160rpx;
}

/* 图片网格 */
.re-img-grid {
  display: flex;
  flex-wrap: wrap;
}

.re-img-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 14rpx 14rpx 0;
  border-radius: 14rpx;
  overflow: hidden;
  background: #eef1f6;
}

.re-img {
  width: 100%;
  height: 100%;
  display: block;
}

.re-img-tag {
  position: absolute;
  left: 0;
  top: 0;
  font-size: 18rpx;
  color: #ffffff;
  background: rgba(99, 102, 241, 0.9);
  padding: 4rpx 12rpx;
  border-bottom-right-radius: 12rpx;
}

.re-img-ops {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-wrap: wrap;
  background: rgba(17, 24, 34, 0.55);
}

.re-img-op {
  flex: 1;
  min-width: 50%;
  padding: 8rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.re-img-op-txt {
  font-size: 18rpx;
  color: #ffffff;
}

.re-img-op-del .re-img-op-txt {
  color: #FFC2C2;
}

.re-img-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 14rpx;
  border: 2rpx dashed #c8d3e0;
  background: #fbfcfe;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.re-img-add-icon {
  font-size: 40rpx;
  color: #9aa6b5;
  line-height: 1;
}

.re-img-add-txt {
  font-size: 20rpx;
  color: #9aa6b5;
  margin-top: 10rpx;
}

.re-video-add {
  width: 100%;
  height: 160rpx;
}

.re-video {
  width: 100%;
  height: 360rpx;
  border-radius: 14rpx;
  background: #000;
}

.re-video-del {
  margin-top: 14rpx;
  display: flex;
  justify-content: flex-end;
}

.re-video-del-txt {
  font-size: 21rpx;
  color: #C0393D;
}

.re-tip {
  display: block;
  margin-top: 10rpx;
  font-size: 19rpx;
  color: #a5aebb;
  line-height: 1.6;
}

/* 底部按钮 */
.re-save {
  height: 96rpx;
  border-radius: 20rpx;
  background: linear-gradient(120deg, #2E7BC4 0%, #185FA5 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 10rpx 22rpx rgba(24, 95, 165, 0.26);
}

.re-delete {
  margin-top: 18rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 2rpx solid #f2d4d4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #C0393D;
}

.re-pad {
  height: 80rpx;
}
