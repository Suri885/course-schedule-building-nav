<!--pages/review-edit/review-edit.wxml - 新建/编辑复习资料-->
<view class="re-bg">

  <view class="re-card">
    <text class="re-label">资料名称</text>
    <input
      class="re-input"
      value="{{title}}"
      bindinput="onTitleInput"
      placeholder="如：政治第三章 错题"
      maxlength="40"
    />
  </view>

  <view class="re-card">
    <text class="re-label">要背 / 要复习的内容</text>
    <textarea
      class="re-textarea"
      value="{{text}}"
      bindinput="onTextInput"
      placeholder="写下题目、知识点或错题题干…"
      maxlength="2000"
      auto-height
      show-confirm-bar="{{false}}"
    />
  </view>

  <!-- 图片 -->
  <view class="re-card">
    <view class="re-label-row">
      <text class="re-label">图片</text>
      <text class="re-hint">可涂抹遮盖，做填空背诵</text>
    </view>

    <view class="re-img-grid">
      <view class="re-img-cell" wx:for="{{images}}" wx:key="*this">
        <image class="re-img" src="{{item}}" mode="aspectFill" data-url="{{item}}" catchtap="previewImage" />
        <text class="re-img-tag" wx:if="{{masks[index]}}">已遮盖</text>
        <view class="re-img-ops">
          <view class="re-img-op" data-index="{{index}}" catchtap="openMask">
            <text class="re-img-op-txt">涂抹</text>
          </view>
          <view class="re-img-op" data-index="{{index}}" catchtap="recognize">
            <text class="re-img-op-txt">识别</text>
          </view>
          <view class="re-img-op" data-index="{{index}}" catchtap="clearMask" wx:if="{{masks[index]}}">
            <text class="re-img-op-txt">还原</text>
          </view>
          <view class="re-img-op re-img-op-del" data-index="{{index}}" catchtap="removeImage">
            <text class="re-img-op-txt">删除</text>
          </view>
        </view>
      </view>

      <view class="re-img-add" bindtap="chooseImages" wx:if="{{images.length < 9}}">
        <text class="re-img-add-icon">＋</text>
        <text class="re-img-add-txt">图片</text>
      </view>
    </view>

    <text class="re-tip">「涂抹」在图上用白色涂掉要背的部分，复习时先看遮盖图，点一下显示原图对照。「识别」会把图中文字提取到答案区（需开通云识别，未开通可手动输入）。</text>
  </view>

  <!-- 视频 -->
  <view class="re-card">
    <view class="re-label-row">
      <text class="re-label">视频</text>
      <text class="re-hint">最多 1 个，最长 5 分钟</text>
    </view>

    <view wx:if="{{video}}">
      <video class="re-video" src="{{video}}" controls object-fit="contain"></video>
      <view class="re-video-del" bindtap="removeVideo">
        <text class="re-video-del-txt">删除视频</text>
      </view>
    </view>
    <view class="re-img-add re-video-add" bindtap="chooseVideo" wx:else>
      <text class="re-img-add-icon">＋</text>
      <text class="re-img-add-txt">视频</text>
    </view>
  </view>

  <!-- 答案 -->
  <view class="re-card">
    <text class="re-label">答案 / 原文</text>
    <textarea
      class="re-textarea re-textarea-answer"
      value="{{answer}}"
      bindinput="onAnswerInput"
      placeholder="背诵答案、原文，或图片识别出的文字；复习时点「显示答案」出现"
      maxlength="3000"
      auto-height
      show-confirm-bar="{{false}}"
    />
  </view>

  <view class="re-save" bindtap="save">{{id ? '保存修改' : '保存并生成复习计划'}}</view>
  <view class="re-delete" wx:if="{{id}}" bindtap="deleteItem">删除这份资料</view>

  <view class="re-pad"></view>
</view>
