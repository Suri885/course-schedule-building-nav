/* pages/extmap/extmap.wxss */
.ext-wrap {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.ext-tip {
  font-size: 26rpx;
  color: #cbd5e1;
  line-height: 1.6;
  background: rgba(37, 99, 235, 0.12);
  border: 1rpx solid rgba(37, 99, 235, 0.3);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.map-box {
  position: relative;
  width: 100%;
  height: 760rpx;
  background: #0b1220;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid #1e293b;
}

.map-canvas {
  width: 100%;
  height: 100%;
}

.cluster-pin {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 5;
}

.cluster-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #ef4444;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 6rpx rgba(239, 68, 68, 0.3);
}

.cluster-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #fff;
  background: rgba(15, 23, 42, 0.85);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.lg-item {
  display: flex;
  align-items: center;
}

.lg-sw {
  width: 22rpx;
  height: 22rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.actions .btn-ghost,
.actions .btn-primary {
  flex: 1;
}

.note {
  font-size: 20rpx;
  color: #64748b;
  line-height: 1.6;
}
