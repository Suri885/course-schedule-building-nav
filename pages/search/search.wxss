/* pages/search/search.wxss */
page {
  background: #0f172a;
  color: #e5e7eb;
}
.sr-wrap {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.sr-tip {
  font-size: 26rpx;
  color: #cbd5e1;
  line-height: 1.6;
  background: rgba(37,99,235,0.12);
  border: 1rpx solid rgba(37,99,235,0.3);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.sr-status {
  font-size: 26rpx;
  color: #94a3b8;
}

.sr-loc {
  color: #34d399;
  font-weight: 500;
}

.sr-input-row {
  display: flex;
  gap: 16rpx;
  align-items: stretch;
}

.sr-input {
  flex: 1;
  background: #1e293b;
  border: 1rpx solid #334155;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  color: #fff;
  font-size: 30rpx;
}

.sr-btn {
  background: #2563eb;
  color: #fff;
  font-size: 28rpx;
  border-radius: 14rpx;
  padding: 0 32rpx;
  line-height: 84rpx;
  margin: 0;
}

.sr-btn::after { border: none; }

.sr-err {
  font-size: 26rpx;
  color: #f87171;
  background: rgba(248,113,113,0.1);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  line-height: 1.6;
}

.sr-ok {
  font-size: 26rpx;
  color: #34d399;
  background: rgba(52,211,153,0.1);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  line-height: 1.7;
  white-space: pre-line;
}

.sr-help {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.6;
}
