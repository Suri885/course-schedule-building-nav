/* pages/second-class/second-class.wxss */
.sc-bg {
  min-height: 100vh;
  background: linear-gradient(160deg, #eaf1fb 0%, #f4f7fc 60%, #eef3fb 100%);
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.sc-intro {
  display: flex;
  flex-direction: column;
  margin-bottom: 36rpx;
}

.sc-intro-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.sc-intro-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a97a8;
}

.sc-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.sc-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 30rpx;
  border-left: 10rpx solid #185FA5;
  box-shadow: 0 10rpx 24rpx rgba(31, 45, 61, 0.07);
}

.sc-card-top {
  display: flex;
  align-items: center;
}

.sc-badge {
  width: 92rpx;
  height: 92rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.2;
  flex-shrink: 0;
}

.sc-card-main {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.sc-card-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.sc-card-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #9aa6b5;
  line-height: 1.5;
}

.sc-card-arrow {
  font-size: 48rpx;
  color: #c7d0dc;
  margin-left: 12rpx;
}

.sc-progress {
  margin-top: 26rpx;
  width: 100%;
  height: 14rpx;
  border-radius: 999rpx;
  background: #eef1f6;
  overflow: hidden;
}

.sc-progress-bar {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.sc-card-foot {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sc-card-score {
  font-size: 24rpx;
  color: #5b6776;
  font-weight: 500;
}

.sc-card-count {
  font-size: 22rpx;
  color: #aab4c0;
}

.sc-card-remain {
  font-size: 21rpx;
  color: #C0393D;
  background: #FDECEC;
  border-radius: 999rpx;
  padding: 3rpx 14rpx;
  margin: 0 12rpx;
}

/* 顶部总览 */
.sc-intro-sum {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.sc-intro-got {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2d3d;
}

.sc-intro-remain {
  font-size: 21rpx;
  color: #C0393D;
  background: #FDECEC;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  margin-left: 16rpx;
}

.sc-intro-pending {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #B8741A;
}
