/* pages/entrance/entrance.wxss */
.en-wrap {
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.en-tip {
  font-size: 26rpx;
  color: #cbd5e1;
  line-height: 1.6;
  background: rgba(16, 185, 129, 0.12);
  border: 1rpx solid rgba(16, 185, 129, 0.3);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

/* 立面：用 CSS 透视模拟楼体外墙 */
.facade {
  position: relative;
  height: 560rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  perspective: 900rpx;
}

.facade-wall {
  width: 92%;
  height: 440rpx;
  background: linear-gradient(160deg, #334155, #1e293b);
  border: 2rpx solid #475569;
  border-radius: 12rpx 12rpx 0 0;
  transform: rotateX(8deg);
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  padding: 0 16rpx 28rpx;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.5);
}

.door {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.door-frame {
  width: 96rpx;
  height: 150rpx;
  background: #0f172a;
  border: 4rpx solid #64748b;
  border-radius: 6rpx 6rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.door-leaf {
  width: 70rpx;
  height: 122rpx;
  background: linear-gradient(160deg, #2563eb, #1d4ed8);
  border-radius: 4rpx;
}

.door-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #e5e7eb;
  background: rgba(15,23,42,0.8);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.facade-ground {
  width: 100%;
  height: 60rpx;
  background: linear-gradient(#1e293b, #0b1220);
  border-radius: 0 0 20rpx 20rpx;
}

.en-hint {
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.6;
}

.btn-ghost {
  margin-top: 8rpx;
}
