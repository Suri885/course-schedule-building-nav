/* pages/index/index.wxss - 课表主页样式
   竖版7天卡片：每天一张大卡片，事项块铺满宽度，不用横滑 */

.schedule-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f0f2f5;
  overflow: hidden;
}

/* ========== 顶部周次选择器 ========== */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid #e8ebed;
  flex-shrink: 0;
  z-index: 4;
  height: 100rpx;
  box-sizing: border-box;
}

.week-nav {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.header-tools {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.tool-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 4rpx 6rpx;
}

.tool-btn:active {
  opacity: 0.6;
}

.tool-icon {
  font-size: 34rpx;
  line-height: 1.2;
}

.tool-label {
  font-size: 18rpx;
  color: #64748b;
  margin-top: 2rpx;
}

.week-arrow {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f1f5f9;
}

.week-arrow:active {
  background: #e2e8f0;
}

.arrow-icon {
  font-size: 36rpx;
  color: #475569;
  line-height: 1;
  font-weight: 600;
}

.week-title {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 160rpx;
  justify-content: center;
}

.week-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
}

.week-sub {
  font-size: 22rpx;
  color: #94a3b8;
}

/* 「本周」标记 */
.week-this {
  font-size: 19rpx;
  color: #185FA5;
  background: #E6F1FB;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  line-height: 1.5;
}

/* ========== 7天卡片列表 ========== */
.swipe-hint {
  flex-shrink: 0;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 20rpx;
  color: #94a3b8;
  background: #fff;
  border-bottom: 1rpx solid #e8ebed;
}

.day-list-scroll {
  width: 100%;
  height: calc(100vh - 140rpx);
}

/* 空周大提示 */
.week-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.week-empty-emoji {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.week-empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #64748b;
  margin-bottom: 8rpx;
}

.week-empty-sub {
  font-size: 24rpx;
  color: #94a3b8;
}

/* ===== 每天一张卡片 ===== */
.day-card {
  margin: 16rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06);
}

.day-card-today {
  border: 2rpx solid #185FA5;
  box-shadow: 0 4rpx 16rpx rgba(24, 95, 165, 0.15);
}

/* 卡片头 */
.day-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid #f0f2f5;
}

.day-card-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.day-card-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.day-card-date {
  font-size: 24rpx;
  color: #94a3b8;
}

.day-card-today-tag {
  font-size: 20rpx;
  color: #fff;
  background: #185FA5;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-weight: 500;
}

/* 每天卡片上的快捷加号 */
.day-add {
  display: flex;
  align-items: center;
  background: #eef4fd;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  flex-shrink: 0;
}

.day-add-icon {
  font-size: 24rpx;
  color: #185FA5;
  line-height: 1;
  margin-right: 6rpx;
}

.day-add-txt {
  font-size: 19rpx;
  color: #185FA5;
}

/* ===== 添加当天事项面板 ===== */
.ev-date-bar {
  background: #EEF4FD;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 18rpx;
}

.ev-date-txt {
  font-size: 23rpx;
  color: #185FA5;
}

.ev-kind-row {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.ev-kind {
  border: 2rpx solid #e4e9f0;
  border-radius: 999rpx;
  padding: 12rpx 22rpx;
  margin: 0 14rpx 14rpx 0;
  font-size: 22rpx;
  color: #667085;
}

.ev-kind-on {
  border-color: #185FA5;
  background: #EEF4FD;
  color: #185FA5;
  font-weight: 600;
}

.ev-mode-row {
  display: flex;
  background: #f1f4f8;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 16rpx;
}

.ev-mode {
  flex: 1;
  text-align: center;
  font-size: 23rpx;
  color: #7b8794;
  padding: 12rpx 0;
  border-radius: 10rpx;
}

.ev-mode-on {
  background: #ffffff;
  color: #1f2d3d;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.08);
}

/* 卡片内容区 */
.day-card-body {
  padding: 12rpx 20rpx 20rpx;
}

/* ===== 事项块（课程/活动/便签通用） ===== */
.schedule-block {
  margin-top: 14rpx;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  overflow: hidden;
}

.schedule-block:active {
  opacity: 0.85;
}

.schedule-block:first-child {
  margin-top: 0;
}

/* 第一行：名称 + 开始时间 */
.block-row1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.block-name {
  font-size: 30rpx;
  font-weight: 700;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;
}

.block-time-start {
  font-size: 24rpx;
  font-weight: 600;
  opacity: 0.8;
  flex-shrink: 0;
  margin-left: 16rpx;
  line-height: 1.3;
}

/* 第二行：时段 + 完整时间 + 地点 */
.block-row2 {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.block-info {
  font-size: 22rpx;
  opacity: 0.75;
  line-height: 1.4;
}

/* 第三行：教师 + 备注 */
.block-row3 {
  margin-top: 4rpx;
  display: flex;
  align-items: center;
}

.block-sub {
  font-size: 21rpx;
  opacity: 0.65;
  line-height: 1.4;
}

/* ===== 活动块（青绿色） ===== */
.block-event {
  background: #CCFBF1;
  border-left: 8rpx solid #14B8A6;
}

.block-event .block-name { color: #0F766E; }
.block-event .block-info { color: #0D9488; }
.block-event .block-sub { color: #0D9488; }
.block-event .block-time-start { color: #0F766E; }

/* ===== 便签块（黄色） ===== */
.block-memo {
  background: #FEF9C3;
  border-left: 8rpx solid #EAB308;
}

.block-memo .block-name { color: #713F12; }
.block-memo .block-info { color: #854D0E; }
.block-memo .block-sub { color: #854D0E; }
.block-memo .block-time-start { color: #713F12; }

/* ===== 课程配色主题 ===== */
.color-blue {
  background: #E6F1FB;
  border-left: 8rpx solid #3B82F6;
}
.color-blue .block-name { color: #0C447C; }
.color-blue .block-info { color: #185FA5; }
.color-blue .block-sub { color: #185FA5; }
.color-blue .block-time-start { color: #0C447C; }

.color-teal {
  background: #E1F5EE;
  border-left: 8rpx solid #10B981;
}
.color-teal .block-name { color: #085041; }
.color-teal .block-info { color: #0F6E56; }
.color-teal .block-sub { color: #0F6E56; }
.color-teal .block-time-start { color: #085041; }

.color-purple {
  background: #EEEDFE;
  border-left: 8rpx solid #7C3AED;
}
.color-purple .block-name { color: #3C3489; }
.color-purple .block-info { color: #534AB7; }
.color-purple .block-sub { color: #534AB7; }
.color-purple .block-time-start { color: #3C3489; }

.color-amber {
  background: #FAEEDA;
  border-left: 8rpx solid #F59E0B;
}
.color-amber .block-name { color: #633806; }
.color-amber .block-info { color: #854F0B; }
.color-amber .block-sub { color: #854F0B; }
.color-amber .block-time-start { color: #633806; }

.color-coral {
  background: #FAECE7;
  border-left: 8rpx solid #EF4444;
}
.color-coral .block-name { color: #712B13; }
.color-coral .block-info { color: #993C1D; }
.color-coral .block-sub { color: #993C1D; }
.color-coral .block-time-start { color: #712B13; }

.color-green {
  background: #EAF3DE;
  border-left: 8rpx solid #22C55E;
}
.color-green .block-name { color: #27500A; }
.color-green .block-info { color: #3B6D11; }
.color-green .block-sub { color: #3B6D11; }
.color-green .block-time-start { color: #27500A; }

.color-pink {
  background: #FBEAF0;
  border-left: 8rpx solid #EC4899;
}
.color-pink .block-name { color: #72243E; }
.color-pink .block-info { color: #993556; }
.color-pink .block-sub { color: #993556; }
.color-pink .block-time-start { color: #72243E; }

/* ===== 空天 ===== */
.day-card-empty {
  padding: 32rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.day-card-empty-text {
  font-size: 24rpx;
  color: #cbd5e1;
}

/* 底部留白 */
.day-list-bottom-pad {
  height: 140rpx;
}

/* ========== 悬浮添加按钮 ========== */
.fab-btn {
  position: fixed;
  right: 36rpx;
  bottom: 80rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #185FA5;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(24, 95, 165, 0.4);
  z-index: 100;
}

.fab-btn:active {
  background: #0C447C;
  transform: scale(0.94);
}

.fab-icon {
  color: #fff;
  font-size: 60rpx;
  line-height: 1;
  margin-top: -6rpx;
}

/* ========== 时段管理 / 活动面板 ========== */
.slot-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.slot-panel {
  width: 100%;
  height: 80vh;
  max-height: 80vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.slot-panel-title-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 16rpx;
}

.slot-panel-body {
  flex: 1;
  min-height: 0;
  padding: 8rpx 32rpx 16rpx;
}

.slot-panel-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.slot-panel-close {
  padding: 8rpx 16rpx;
}

.slot-panel-close-text {
  font-size: 32rpx;
  color: #999;
}

.slot-panel-tip {
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.slot-manage-list {
  margin-bottom: 24rpx;
}

.slot-manage-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 10rpx;
}

.slot-manage-label-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.slot-manage-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.slot-edit-pencil {
  font-size: 20rpx;
  color: #bbb;
  flex-shrink: 0;
}

.slot-time-pick-mini {
  background: #f5f7fa;
  border-radius: 8rpx;
  padding: 10rpx 14rpx;
  font-size: 24rpx;
  color: #185FA5;
  text-align: center;
  min-width: 80rpx;
}

.slot-time-sep-mini {
  font-size: 22rpx;
  color: #ccc;
}

.slot-manage-del {
  padding: 6rpx 16rpx;
}

.slot-manage-del-text {
  font-size: 24rpx;
  color: #e64340;
}

.slot-add-area {
  flex-shrink: 0;
  background: #fafafa;
  border-top: 1rpx solid #ececec;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.04);
}

.slot-add-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 14rpx;
  display: block;
}

.slot-add-field {
  background: #fff;
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #e8e8e8;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.slot-add-field-label {
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.slot-add-field-value {
  font-size: 30rpx;
  color: #333;
  flex: 1;
}

.slot-add-field-value.placeholder {
  color: #bbb;
}

.slot-add-days {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.day-toggles {
  flex: 1;
  display: flex;
  gap: 8rpx;
}

.day-toggle {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #666;
  background: #fff;
  border-radius: 10rpx;
  border: 1rpx solid #e8e8e8;
}

.day-toggle.on {
  background: #185FA5;
  color: #fff;
  border-color: #185FA5;
}

.slot-week-pick {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 22rpx 0;
  font-size: 30rpx;
  color: #185FA5;
  text-align: center;
  border: 1rpx solid #e8e8e8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.slot-add-time-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.slot-time-pick {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  color: #185FA5;
  text-align: center;
  border: 1rpx solid #e8e8e8;
  min-height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.slot-time-sep {
  font-size: 26rpx;
  color: #999;
}

.slot-add-btn {
  background: #185FA5;
  border-radius: 12rpx;
  padding: 22rpx 0;
  display: flex;
  justify-content: center;
}

.slot-add-btn:active {
  background: #0F4780;
}

.slot-add-btn-text {
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
}

.slot-reset-btn {
  margin-top: 16rpx;
  padding: 14rpx 0;
  text-align: center;
}

.slot-reset-btn:active {
  opacity: 0.5;
}

.slot-reset-btn-text {
  font-size: 24rpx;
  color: #999;
}

/* 添加活动面板 */
.event-panel {
  height: auto;
  max-height: 85vh;
}

/* ===== 提醒按钮冲突角标 ===== */
.tool-icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool-badge {
  position: absolute;
  top: -10rpx;
  right: -14rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 14rpx;
  background: #e64340;
  color: #fff;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
  box-sizing: border-box;
}

/* ===== 事项块冲突高亮 ===== */
.block-conflict {
  border: 2rpx solid #e64340 !important;
  border-left-width: 8rpx !important;
}

.block-conflict-tag {
  font-size: 20rpx;
  color: #e64340;
  font-weight: 600;
  margin-bottom: 6rpx;
  line-height: 1.3;
}

/* ===== 活动面板实时冲突横幅 ===== */
.ev-conflict-banner {
  background: #FEE2E2;
  border: 1rpx solid #FCA5A5;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
}

.ev-conflict-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #b91c1c;
  margin-bottom: 6rpx;
}

.ev-conflict-item {
  font-size: 22rpx;
  color: #b91c1c;
  line-height: 1.5;
}

/* ===== 智能面板 ===== */
.smart-panel {
  height: 82vh;
  max-height: 82vh;
}

.smart-recs {
  margin-bottom: 24rpx;
}

.smart-rec {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: #E6F1FB;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 12rpx;
}

.smart-rec-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

/* ===== 本周空闲时间（周视图顶层一行） ===== */
.free-bar {
  background: #ffffff;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(31, 45, 61, 0.05);
  margin: 16rpx 24rpx;
  overflow: hidden;
}

.free-bar-open {
  box-shadow: inset 0 0 0 1rpx #D8EEE1, 0 4rpx 14rpx rgba(31, 45, 61, 0.05);
}

.free-bar-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 22rpx;
}

.free-bar-head:active {
  background: #F6FAF7;
}

.free-bar-icon {
  font-size: 30rpx;
  flex-shrink: 0;
}

.free-bar-texts {
  flex: 1;
  min-width: 0;
}

.free-bar-title-row {
  display: flex;
  align-items: center;
}

.free-bar-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #1f2d3d;
  margin-right: 10rpx;
}

.free-bar-sum {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #5f8a71;
  line-height: 1.45;
}

.free-bar-toggle {
  flex-shrink: 0;
  font-size: 21rpx;
  font-weight: 600;
  color: #15803D;
  margin-left: 10rpx;
}

.free-week {
  padding: 0 22rpx 16rpx;
  border-top: 1rpx dashed #E6EEF7;
}

.free-day {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f5f9;
}

.free-day:last-child {
  border-bottom: none;
}

.free-day-today {
  background: #F4F9FF;
  border-radius: 12rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
}

.free-day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.free-day-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #475569;
}

.free-day-today .free-day-label {
  color: #185FA5;
}

.free-day-total {
  font-size: 19rpx;
  color: #5f8a71;
}

.free-day-total-none {
  color: #b9c3d0;
}

.free-gaps {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.free-gap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #EAF7EF;
  border-radius: 10rpx;
  padding: 8rpx 14rpx;
}

.free-gap:active {
  background: #D3F0E0;
}

.free-gap-time {
  font-size: 21rpx;
  font-weight: 600;
  color: #15803D;
}

.free-gap-dur {
  font-size: 19rpx;
  color: #5f8a71;
}

.free-foot {
  display: block;
  padding-top: 10rpx;
  font-size: 19rpx;
  color: #9aa7b6;
  line-height: 1.5;
}

.smart-rec-text {
  font-size: 24rpx;
  color: #0C447C;
  line-height: 1.5;
}

.smart-day {
  margin-bottom: 24rpx;
}

.smart-day-head {
  padding: 10rpx 0 14rpx;
  border-bottom: 1rpx solid #f0f2f5;
  margin-bottom: 12rpx;
}

.smart-day-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.smart-day-empty {
  padding: 16rpx 0;
}

.smart-day-empty-text {
  font-size: 22rpx;
  color: #cbd5e1;
}

.smart-gap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #F0FDF4;
  border: 1rpx solid #BBF7D0;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 12rpx;
}

.smart-gap:active {
  background: #DCFCE7;
}

.smart-gap-time {
  font-size: 26rpx;
  font-weight: 600;
  color: #166534;
  flex-shrink: 0;
}

.smart-gap-dur {
  font-size: 22rpx;
  color: #15803D;
  flex: 1;
}

.smart-gap-add {
  font-size: 22rpx;
  color: #fff;
  background: #22C55E;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  flex-shrink: 0;
}

/* ========== 大屏适配（折叠屏展开态） ========== */
@media (min-width: 550px) {
  .header { padding: 14px 22px; }
  .week-text { font-size: 18px; }
  .week-sub { font-size: 12px; }
  .arrow-icon { font-size: 22px; }
  .week-arrow { width: 36px; height: 36px; }
  .tool-icon { font-size: 18px; }
  .tool-label { font-size: 11px; }

  .day-card { margin: 10px 16px; border-radius: 12px; }
  .day-card-header { padding: 14px 20px; }
  .day-card-label { font-size: 18px; }
  .day-card-date { font-size: 13px; }
  .day-card-today-tag { font-size: 11px; padding: 2px 8px; }
  .day-card-body { padding: 8px 14px 14px; }

  .schedule-block { padding: 12px 16px; border-radius: 10px; margin-top: 8px; }
  .block-name { font-size: 16px; }
  .block-time-start { font-size: 13px; }
  .block-info { font-size: 12px; }
  .block-sub { font-size: 11px; }

  .day-card-empty { padding: 20px 14px; }
  .day-card-empty-text { font-size: 13px; }
  .day-list-bottom-pad { height: 80px; }
  .swipe-hint { height: 20px; line-height: 20px; font-size: 11px; }
  .day-list-scroll { height: calc(100vh - 100rpx - 20px); }

  .week-empty-emoji { font-size: 48px; }
  .week-empty-text { font-size: 18px; }
  .week-empty-sub { font-size: 13px; }

  .fab-btn { width: 56px; height: 56px; right: 28px; bottom: 40px; border-radius: 28px; }
  .fab-icon { font-size: 32px; margin-top: -3px; }

  .slot-panel { max-width: 700px; margin: 0 auto; width: 100%; border-radius: 20px 20px 0 0; }
  .event-panel { max-width: 600px; max-height: 85vh; }
  .slot-manage-label { font-size: 16px; }
  .slot-edit-pencil { font-size: 12px; }
  .slot-time-pick-mini { font-size: 13px; padding: 8px 12px; min-width: 70px; }
  .slot-time-sep-mini { font-size: 12px; }
  .slot-manage-del-text { font-size: 13px; }
  .slot-add-field { padding: 14px 18px; }
  .slot-add-field-label { font-size: 14px; }
  .slot-add-field-value { font-size: 17px; }
  .day-toggle { font-size: 14px; padding: 10px 0; }
  .slot-week-pick { font-size: 16px; padding: 14px 0; }
  .slot-time-pick { font-size: 18px; padding: 16px 0; }
  .slot-add-btn { padding: 14px 0; border-radius: 8px; }
  .slot-add-btn-text { font-size: 16px; }

  .tool-badge { min-width: 16px; height: 16px; font-size: 11px; line-height: 16px; border-radius: 8px; }
  .smart-panel { max-width: 700px; margin: 0 auto; }
  .smart-rec { padding: 12px 16px; }
  .smart-rec-text { font-size: 14px; }
  .smart-day-label { font-size: 17px; }
  .smart-gap { padding: 12px 16px; border-radius: 8px; }
  .smart-gap-time { font-size: 15px; }
  .smart-gap-dur { font-size: 13px; }
  .smart-gap-add { font-size: 12px; padding: 4px 12px; }
  .block-conflict-tag { font-size: 12px; }
  .ev-conflict-title { font-size: 14px; }
  .ev-conflict-item { font-size: 13px; }
}
