/* app.wxss - 全局样式 */

page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background-color: #f5f5f5;
  color: #333;
  font-size: 28rpx;
  box-sizing: border-box;
}

view, text, scroll-view, button, input, textarea {
  box-sizing: border-box;
}

/* ===== 教学楼内部导航：沿用独立项目的深色底与按钮样式 ===== */
.ext-wrap, .en-wrap, .sr-wrap {
  min-height: 100vh;
  background: #0f172a;
  color: #e5e7eb;
}

.btn-primary {
  background: #2563eb;
  color: #fff;
  border-radius: 16rpx;
  padding: 22rpx 0;
  text-align: center;
  font-size: 30rpx;
}

.btn-ghost {
  background: rgba(255,255,255,0.08);
  color: #cbd5e1;
  border: 1rpx solid rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 28rpx;
}
